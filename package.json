{
  "name": "storage-controller",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "test": "vitest run src --exclude frontend/** --exclude **/*.db.test.ts --maxWorkers=1",
    "build": "tsc -p tsconfig.json && node scripts/write-version.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:seed": "npm run db:generate && npm run build && node --env-file=.env dist/infrastructure/database/seed.js",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run src/infrastructure/database/reservation.db.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "3.9.9",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/session": "^11.1.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  }
}
